{#
  Filament DB settings content. OctoPrint supplies the settings-dialog
  wrapper (id="settings_plugin_filamentdb") -- this template is content
  only. Bootstrap 2 form markup so theme plugins can restyle it (never
  hardcode colours here).

  Bound (custom_bindings) to static/js/filamentdb.js's FilamentDBViewModel,
  which exposes `settingsViewModel` (parameters[0]). Read
  `settingsViewModel.settings...` directly here rather than through an
  alias cached at construction time -- see the comment in filamentdb.js
  for why that breaks.
#}
<form class="form-horizontal" data-bind="with: settingsViewModel.settings.plugins.filamentdb">
    <div class="control-group">
        <label class="control-label" for="filamentdb-url">{{ _('Filament DB URL') }}</label>
        <div class="controls">
            <input type="text" class="input-block-level" id="filamentdb-url"
                   data-bind="value: filamentDbUrl"
                   placeholder="http://filament-db.local:3000">
        </div>
    </div>
    <div class="control-group">
        <label class="control-label" for="filamentdb-api-key">{{ _('API key') }}</label>
        <div class="controls">
            <input type="password" class="input-block-level" id="filamentdb-api-key"
                   data-bind="value: filamentDbApiKey"
                   placeholder="{{ _('optional -- only needed if FILAMENTDB_API_KEY is set') }}">
            <span class="help-block">{{ _('Only sent to the URL above. Never shown to non-admin users.') }}</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label" for="filamentdb-request-timeout">{{ _('Request timeout (seconds)') }}</label>
        <div class="controls">
            <input type="number" class="input-mini" min="1" step="1"
                   id="filamentdb-request-timeout"
                   data-bind="value: requestTimeout">
        </div>
    </div>
    <div class="control-group">
        <label class="control-label" for="filamentdb-cache-ttl">{{ _('Spool list cache TTL (seconds)') }}</label>
        <div class="controls">
            <input type="number" class="input-mini" min="0" step="1"
                   id="filamentdb-cache-ttl"
                   data-bind="value: cacheTtlSeconds">
            <span class="help-block">{{ _('How long the picker re-uses a fetched spool list before refetching. The sidebar\'s Refresh button always bypasses this.') }}</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label" for="filamentdb-tool-offset">{{ _('Tool display offset') }}</label>
        <div class="controls">
            <input type="number" class="input-mini" step="1"
                   id="filamentdb-tool-offset"
                   data-bind="value: toolDisplayOffset">
            <span class="help-block">{{ _('OctoPrint numbers tools from 0 internally. This only changes what is shown on screen -- default 1 so "Tool 1" matches the printer and Filament DB.') }}</span>
        </div>
    </div>
</form>

{# Outside the `with: settingsViewModel.settings...` block above on
   purpose -- these are FilamentDBViewModel's own methods/observables
   (testConnection et al.), not settings fields. A `with` binding rebinds
   $data to the settings sub-object for everything inside it, so a bare
   `testConnection` there resolves against $data first and is never found
   -- caught live via a Playwright console check (docs/decisions.md). #}
<div class="control-group">
    <div class="controls">
        <button type="button" class="btn" data-bind="click: testConnection, enable: !testingConnection()">
            <i class="fas fa-plug"></i> {{ _('Test connection') }}
        </button>
        <span data-bind="visible: testingConnection" class="muted">{{ _('Testing...') }}</span>
        <!-- ko if: testConnectionResult() && testConnectionResult().connected -->
        <span class="text-success" data-bind="text: 'Connected -- Filament DB v' + testConnectionResult().version"></span>
        <!-- /ko -->
        <!-- ko if: testConnectionResult() && !testConnectionResult().connected -->
        <span class="text-error" data-bind="text: 'Could not connect: ' + testConnectionResult().error"></span>
        <!-- /ko -->
    </div>
</div>
